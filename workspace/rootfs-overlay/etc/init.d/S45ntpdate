#!/bin/sh
# Compatibility placeholder: time synchronization is handled by Buildroot's
# /etc/init.d/S49ntp. Keep this file to replace old copies in incremental builds.
# Never wait for network access or start a second ntpd here.
case "$1" in
    start|stop|restart|reload)
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}" >&2
        exit 1
        ;;
esac
